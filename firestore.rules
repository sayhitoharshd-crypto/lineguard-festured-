rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId} {
      allow create: if request.auth != null && request.auth.uid == userId
        && request.resource.data.keys().hasOnly(["name", "email", "color", "createdAt", "phoneNumber", "phoneVerified"])
        && (
          (request.auth.token.email != null
            && request.resource.data.email == request.auth.token.email
            && request.resource.data.phoneVerified == false)
          ||
          (request.auth.token.phone_number != null
            && request.resource.data.phoneNumber == request.auth.token.phone_number
            && request.resource.data.phoneVerified == true)
        );
      allow read: if request.auth != null && request.auth.uid == userId;
      allow update: if request.auth != null && request.auth.uid == userId
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["name"]);
      allow delete: if false;
    }

    // Case records, evidence metadata, payment state, and audit events are
    // intentionally server-only. The authenticated API will enforce the
    // two-party case permissions and verified payment webhooks.
    match /cases/{caseId} { allow read, write: if false; }
    match /caseEvents/{eventId} { allow read, write: if false; }
    match /payments/{paymentId} { allow read, write: if false; }
    match /{document=**} { allow read, write: if false; }
  }
}
